# Copy to .env to override defaults (all optional). Never commit a real .env (it is gitignored).

# Dataset: demo (default, synthetic, shareable) | openfootball (public domain) | premier-league (local use only)
# EPL_DATASET=demo

# Database (defaults to data/<dataset>.db). PostgreSQL example:
# EPL_DATABASE_URL=postgresql+psycopg://epl:epl@localhost:5432/epl

# Admin endpoints (POST /api/v1/admin/refresh) are disabled unless this is set. It must be 32+ random
# characters; weak values make the app refuse to start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# EPL_ADMIN_TOKEN=

# Simulation resource limits (per API process)
# EPL_SIMULATION_RUN_SIZES=[1000,10000]
# EPL_SIMULATION_RATE_PER_MINUTE=20
# EPL_SIMULATION_MAX_CONCURRENCY=2
# EPL_SIMULATION_QUEUE_TIMEOUT_SECONDS=10
# EPL_SIMULATION_CACHE_MAX_ROWS=256

# How stale a cached frame or model may be before the API re-checks the persisted versions
# EPL_CACHE_CHECK_INTERVAL_SECONDS=1

# Logging
# EPL_LOG_JSON=true
# EPL_LOG_LEVEL=INFO
